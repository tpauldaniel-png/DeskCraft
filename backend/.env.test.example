# DeskCraft test environment
ENVIRONMENT=test

# Dedicated test database only
# Replace placeholders after copying this file to .env.test
TEST_DATABASE_URL=postgresql+asyncpg://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/deskcraft_test
DATABASE_URL=postgresql+asyncpg://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/deskcraft_test

# Test-only authentication settings
JWT_SECRET_KEY=test-only-secret-key-not-for-production-123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# False because tests use http://test
AUTH_COOKIE_SECURE=false